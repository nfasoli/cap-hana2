-- Si chiama mapping view e serve solo ed esclusivamente per gestire la case sensitiveness di hana
VIEW METAL_MES_PRD_LIST_PRODOTTE_MAPPED AS SELECT
  METAL_MES_PRD_LIST_PRODOTTE."Code" as Code,
  METAL_MES_PRD_LIST_PRODOTTE."LineId" as LineId,
  METAL_MES_PRD_LIST_PRODOTTE."s_Modello" as s_Modello,
  METAL_MES_PRD_LIST_PRODOTTE."s_Cliente" as s_Cliente,
  METAL_MES_PRD_LIST_PRODOTTE."s_Lega" as s_Lega,
  METAL_MES_PRD_LIST_PRODOTTE."n_Temp" as n_Temp,
  METAL_MES_PRD_LIST_PRODOTTE."s_Commessa" as s_Commessa,
  METAL_MES_PRD_LIST_PRODOTTE."U_Impianto" as U_Impianto,
  METAL_MES_PRD_LIST_PRODOTTE."n_Anime" as n_Anime,
  METAL_MES_PRD_LIST_PRODOTTE."n_Mod_Pla" as n_Mod_Pla,
  METAL_MES_PRD_LIST_PRODOTTE."n_PesoTotale" as n_PesoTotale,
  METAL_MES_PRD_LIST_PRODOTTE."s_Cod_Pla" as s_Cod_Pla,
  METAL_MES_PRD_LIST_PRODOTTE."s_Posizione" as s_Posizione,
  METAL_MES_PRD_LIST_PRODOTTE."n_Num_Pla" as n_Num_Pla,
  METAL_MES_PRD_LIST_PRODOTTE."n_Prodotte" as n_Prodotte,
  METAL_MES_PRD_LIST_PRODOTTE."n_Bianche" as n_Bianche,
  METAL_MES_PRD_LIST_PRODOTTE."n_Tutte" as n_Tutte,
  METAL_MES_PRD_LIST_PRODOTTE."s_InProduzione" as s_InProduzione,
  METAL_MES_PRD_LIST_PRODOTTE."n_P_Totale" as n_P_Totale,
  METAL_MES_PRD_LIST_PRODOTTE."n_Seq" as n_Seq,
  METAL_MES_PRD_LIST_PRODOTTE."s_Note" as s_Note,
  METAL_MES_PRD_LIST_PRODOTTE."dt_DataProduzione" as dt_DataProduzione,
  METAL_MES_PRD_LIST_PRODOTTE."dt_Inizio" as dt_Inizio,
  METAL_MES_PRD_LIST_PRODOTTE."dt_Fine" as dt_Fine,
  METAL_MES_PRD_LIST_PRODOTTE."dt_InizioOra" as dt_InizioOra,
  METAL_MES_PRD_LIST_PRODOTTE."dt_FineOra" as dt_FineOra,
  METAL_MES_PRD_LIST_PRODOTTE."inizio_produzione" as inizio_produzione,
  METAL_MES_PRD_LIST_PRODOTTE."inizio_sospensione" as inizio_sospensione,
  METAL_MES_PRD_LIST_PRODOTTE."peso_medio" as peso_medio,
  METAL_MES_PRD_LIST_PRODOTTE."tempo_produzione" as tempo_produzione,
  METAL_MES_PRD_LIST_PRODOTTE."tempo_manodopera" as tempo_manodopera,
  METAL_MES_PRD_LIST_PRODOTTE."tempo_attrezzaggio" as tempo_attrezzaggio,
  METAL_MES_PRD_LIST_PRODOTTE."pezzi_prodotti" as pezzi_prodotti,
  METAL_MES_PRD_LIST_PRODOTTE."chiuso" as chiuso
FROM METAL_MES_PRD_LIST_PRODOTTE
