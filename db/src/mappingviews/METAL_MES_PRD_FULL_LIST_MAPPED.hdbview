-- Si chiama mapping view e serve solo ed esclusivamente per gestire la case sensitiveness di hana
VIEW METAL_MES_PRD_FULL_LIST_MAPPED AS SELECT
  METAL_MES_PRD_FULL_LIST."Code" as Code,
  METAL_MES_PRD_FULL_LIST."LineId" as LineId,
  METAL_MES_PRD_FULL_LIST."LineId_1" as LineId_1,
  METAL_MES_PRD_FULL_LIST."s_Modello" as s_Modello,
  METAL_MES_PRD_FULL_LIST."s_Cliente" as s_Cliente,
  METAL_MES_PRD_FULL_LIST."s_Lega" as s_Lega,
  METAL_MES_PRD_FULL_LIST."n_Temp" as n_Temp,
  METAL_MES_PRD_FULL_LIST."s_Commessa" as s_Commessa,
  METAL_MES_PRD_FULL_LIST."n_Anime" as n_Anime,
  METAL_MES_PRD_FULL_LIST."n_Mod_Pla" as n_Mod_Pla,
  METAL_MES_PRD_FULL_LIST."n_PesoTotale" as n_PesoTotale,
  METAL_MES_PRD_FULL_LIST."s_Cod_Pla" as s_Cod_Pla,
  METAL_MES_PRD_FULL_LIST."s_Posizione" as s_Posizione,
  METAL_MES_PRD_FULL_LIST."n_Num_Pla" as n_Num_Pla,
  METAL_MES_PRD_FULL_LIST."n_Prodotte" as n_Prodotte,
  METAL_MES_PRD_FULL_LIST."n_Bianche" as n_Bianche,
  METAL_MES_PRD_FULL_LIST."n_Tutte" as n_Tutte,
  METAL_MES_PRD_FULL_LIST."s_InProduzione" as s_InProduzione,
  METAL_MES_PRD_FULL_LIST."n_P_Totale" as n_P_Totale,
  METAL_MES_PRD_FULL_LIST."n_Seq" as n_Seq,
  METAL_MES_PRD_FULL_LIST."s_Note" as s_Note,
  METAL_MES_PRD_FULL_LIST."dt_DataProduzione" as dt_DataProduzione,
  METAL_MES_PRD_FULL_LIST."dt_Inizio" as dt_Inizio,
  METAL_MES_PRD_FULL_LIST."dt_Fine" as dt_Fine,
  METAL_MES_PRD_FULL_LIST."dt_InizioOra" as dt_InizioOra,
  METAL_MES_PRD_FULL_LIST."dt_FineOra" as dt_FineOra
FROM METAL_MES_PRD_FULL_LIST
